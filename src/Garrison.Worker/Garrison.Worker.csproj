<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsGarrisonLibrary>true</IsGarrisonLibrary>
    <OutputType>Exe</OutputType>
    <RootNamespace>Garrison.Worker</RootNamespace>
    <AssemblyName>Garrison.Worker</AssemblyName>
    <StartupObject>Garrison.Worker.Program</StartupObject>
    <Description>Garrison worker node (Post).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KubernetesClient" Version="19.0.2" />
    <PackageReference Include="Padlock" Version="1.2.1" />
    <PackageReference Include="SyslogLogging" Version="2.4.0" />
    <PackageReference Include="Watson" Version="7.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sdk\csharp\Garrison.Sdk\Garrison.Sdk.csproj" />
    <ProjectReference Include="..\Garrison.Core\Garrison.Core.csproj" />
    <ProjectReference Include="..\Garrison.Harnesses\Garrison.Harnesses.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="garrison-worker.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Test.Shared" />
  </ItemGroup>

</Project>
