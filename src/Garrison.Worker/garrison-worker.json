{
  "ServerUrl": "http://127.0.0.1:8700",
  "NodeName": null,
  "AccessKey": "access_garrison_node",
  "SecretKey": "secret_garrison_node_change_me",
  "Labels": {
    "garrison.io/pool": "default"
  },
  "NodePool": null,
  "MaxConcurrentRuns": 4,
  "WorkRoot": "workspaces",
  "ConversationRetentionHours": 24,
  "ConversationSweepIntervalSeconds": 600,
  "HealthHostname": "*",
  "HealthPort": 8710,
  "HeartbeatIntervalMs": 5000,
  "PauseGraceMs": 5000,
  "LeaseWaitMs": 20000,
  "EventFlushIntervalMs": 250,
  "EventBatchSize": 100,
  "MaxBufferedEvents": 20000,
  "DrainTimeoutSeconds": 900,
  "CompletionRetrySeconds": 600,
  "ProbeIntervalSeconds": 600,
  "McpPreflightTimeoutMs": 20000,
  "EnvironmentAllowlist": [
    "PATH",
    "LANG",
    "LC_ALL",
    "TZ",
    "USER",
    "TMPDIR",
    "TEMP",
    "TMP",
    "DOTNET_ROOT",
    "SSL_CERT_FILE",
    "SSL_CERT_DIR",
    "NODE_EXTRA_CA_CERTS",
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "NO_PROXY",
    "http_proxy",
    "https_proxy",
    "no_proxy",
    "SYSTEMROOT",
    "WINDIR",
    "COMSPEC",
    "PATHEXT"
  ],
  "Probes": [
    {
      "HarnessType": "ClaudeCode",
      "Executable": "claude",
      "Arguments": [
        "--version"
      ],
      "Label": "claude"
    },
    {
      "HarnessType": "Codex",
      "Executable": "codex",
      "Arguments": [
        "--version"
      ],
      "Label": "codex"
    },
    {
      "HarnessType": "Mux",
      "Executable": "mux",
      "Arguments": [
        "--version"
      ],
      "Label": "mux"
    },
    {
      "HarnessType": "GeminiCli",
      "Executable": "gemini",
      "Arguments": [
        "--version"
      ],
      "Label": "gemini"
    },
    {
      "HarnessType": "Generic",
      "Executable": "garrison-fake-harness",
      "Arguments": [
        "--version"
      ],
      "Label": "fake"
    }
  ],
  "Telemetry": {
    "Enabled": true,
    "ServiceName": "garrison-worker",
    "PrometheusEnable": true,
    "PrometheusHostname": "*",
    "PrometheusPort": 9465,
    "PrometheusPath": "/metrics",
    "OtlpEnable": false,
    "OtlpEndpoint": "http://127.0.0.1:4317"
  },
  "Logging": {
    "ConsoleLogging": true,
    "MinimumSeverity": 1
  }
}
