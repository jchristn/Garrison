{
  "spec": {
    "runId": "run_golden",
    "tenantId": "ten_golden",
    "agentName": "helper-mux-full",
    "deploymentId": "dep_mux_full",
    "deploymentName": "helper-mux-full-default",
    "harnessType": "Mux",
    "executable": "mux",
    "arguments": [
      "--print",
      "--config-dir",
      "$GARRISON_CONFIG_DIR/mux",
      "-e",
      "garrison",
      "--output-format",
      "jsonl",
      "--yolo",
      "--sandbox",
      "workspace-write",
      "-w",
      "$GARRISON_WORKSPACE_DIR",
      "-m",
      "test-model",
      "--context-window",
      "131072",
      "--max-turns",
      "12",
      "--system-prompt",
      "$GARRISON_CONFIG_DIR/system-prompt.md",
      "--mcp-config",
      "$GARRISON_CONFIG_DIR/mux-mcp.json",
      "--strict-mcp-config",
      "--output-schema",
      "$GARRISON_CONFIG_DIR/output-schema.json",
      "--output-last-message",
      "$GARRISON_CONFIG_DIR/last-message.txt",
      "--session-id",
      "run_golden"
    ],
    "environment": [
      {
        "name": "GARRISON_MCP_0_H0",
        "value": "Bearer run-token-golden",
        "isSecret": true
      },
      {
        "name": "GARRISON_MCP_0_BEARER",
        "value": "run-token-golden",
        "isSecret": true
      },
      {
        "name": "GARRISON_MCP_1_H0",
        "value": "Bearer docs-token-mux_full",
        "isSecret": true
      },
      {
        "name": "GARRISON_MCP_1_BEARER",
        "value": "docs-token-mux_full",
        "isSecret": true
      },
      {
        "name": "GARRISON_MUX_API_KEY",
        "value": "credential-mux_full",
        "isSecret": true
      },
      {
        "name": "MUX_TELEMETRY_ENABLED",
        "value": "false",
        "isSecret": false
      },
      {
        "name": "MUX_CONFIG_DIR",
        "value": "$GARRISON_CONFIG_DIR/mux",
        "isSecret": false
      }
    ],
    "files": [
      {
        "baseDirectory": "Config",
        "path": "system-prompt.md",
        "content": "You are Helper, an agent operated by Garrison.\n\nAnswers questions about the repository.\n\nWork only inside your current working directory. When you are done, reply with your final answer.\n\nYou can hand work to other Garrison agents through the \u0022garrison\u0022 MCP server:\n- garrison_list_agents shows the agents you may call and what each one does.\n- garrison_invoke_agent sends a message to an agent and waits for its answer. If it returns a run ID instead of an answer, call garrison_get_run until the run finishes.\n\nDelegate only when another agent is better suited to part of the task. You may call: codex-coder. Delegation can go at most 2 levels below you.\n\n",
        "isSecret": false
      },
      {
        "baseDirectory": "Config",
        "path": "output-schema.json",
        "content": "{\u0022type\u0022:\u0022object\u0022,\u0022properties\u0022:{\u0022answer\u0022:{\u0022type\u0022:\u0022string\u0022}},\u0022required\u0022:[\u0022answer\u0022],\u0022additionalProperties\u0022:false}",
        "isSecret": false
      },
      {
        "baseDirectory": "Config",
        "path": "mux/endpoints.json",
        "content": "{\n  \u0022endpoints\u0022: [\n    {\n      \u0022name\u0022: \u0022garrison\u0022,\n      \u0022adapterType\u0022: \u0022openai-compatible\u0022,\n      \u0022baseUrl\u0022: \u0022http://ollama:11434/v1\u0022,\n      \u0022model\u0022: \u0022test-model\u0022,\n      \u0022apiKey\u0022: \u0022${GARRISON_MUX_API_KEY}\u0022,\n      \u0022isDefault\u0022: true,\n      \u0022timeoutMs\u0022: 600000,\n      \u0022maxTokens\u0022: 16384,\n      \u0022autoApproveTools\u0022: true\n    }\n  ]\n}\n",
        "isSecret": false
      },
      {
        "baseDirectory": "Config",
        "path": "mux/settings.json",
        "content": "{\n  \u0022skillsEnabled\u0022: false,\n  \u0022projectSkillsEnabled\u0022: false,\n  \u0022taskPlanningEnabled\u0022: false,\n  \u0022memoryEnabled\u0022: false,\n  \u0022fileMentionMaxBytes\u0022: 0,\n  \u0022setupCompleted\u0022: true\n}\n",
        "isSecret": false
      },
      {
        "baseDirectory": "Config",
        "path": "mux/subagents.json",
        "content": "{\n  \u0022subagents\u0022: []\n}\n",
        "isSecret": false
      },
      {
        "baseDirectory": "Config",
        "path": "mux-mcp.json",
        "content": "{\n  \u0022servers\u0022: [\n    { \u0022name\u0022: \u0022garrison\u0022, \u0022transport\u0022: \u0022http\u0022, \u0022url\u0022: \u0022http://garrison-server:8701\u0022, \u0022mcpPath\u0022: \u0022/mcp\u0022, \u0022auth\u0022: { \u0022type\u0022: \u0022bearer\u0022, \u0022bearerToken\u0022: \u0022${GARRISON_MCP_0_BEARER}\u0022 } },\n    { \u0022name\u0022: \u0022docs\u0022, \u0022transport\u0022: \u0022http\u0022, \u0022url\u0022: \u0022https://mcp.example.com\u0022, \u0022mcpPath\u0022: \u0022/mcp\u0022, \u0022auth\u0022: { \u0022type\u0022: \u0022bearer\u0022, \u0022bearerToken\u0022: \u0022${GARRISON_MCP_1_BEARER}\u0022 } }\n  ]\n}\n",
        "isSecret": false
      }
    ],
    "stdin": "The agent \u0022planner\u0022 is asking you for help as part of a larger task (delegation depth 1). Reply with a concise, self-contained answer that agent can use directly.\n\nRequest:\nSummarize the repository.\n",
    "workspace": {
      "kind": "GitRepository",
      "gitUrl": "https://github.com/example/repo.git",
      "gitRef": "main",
      "gitDepth": 1,
      "gitUsername": "x-access-token",
      "gitPassword": "git-token-mux_full",
      "files": [],
      "retention": "Delete"
    },
    "parser": "MuxJsonl",
    "parserOptions": {
      "approvalsRelayed": false
    },
    "resultSource": "LastMessageFile",
    "resultFileName": "last-message.txt",
    "successPolicy": "FinalEventAndExitCode",
    "successExitCodes": [
      0
    ],
    "timeoutSeconds": 1800,
    "killGraceSeconds": 5,
    "maxOutputBytes": 67108864,
    "stderrTailBytes": 8000,
    "repetitionGuard": true,
    "maxAssistantChars": 200000,
    "noProgressSeconds": 300,
    "isolateHome": true,
    "mcpPreflight": [
      {
        "name": "garrison",
        "url": "http://garrison-server:8701",
        "path": "/mcp",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer run-token-golden",
            "isSecret": true
          }
        ],
        "requiredTools": [
          "garrison_invoke_agent"
        ],
        "required": true
      },
      {
        "name": "docs",
        "url": "https://mcp.example.com",
        "path": "/mcp",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer docs-token-mux_full",
            "isSecret": true
          }
        ],
        "requiredTools": [
          "search"
        ],
        "required": true
      }
    ],
    "scrubValues": [
      "Bearer docs-token-mux_full",
      "Bearer run-token-golden",
      "credential-mux_full",
      "docs-token-mux_full",
      "git-token-mux_full",
      "run-token-golden"
    ],
    "assetFiles": [],
    "fileSpace": {
      "mountPath": "files",
      "maxFileBytes": 33554432,
      "maxFiles": 1000,
      "files": []
    },
    "retainForRepair": true,
    "repairAttempt": 0,
    "executor": "Process",
    "egressRules": []
  },
  "templateVersions": [
    {
      "id": "rtv_golden_0",
      "runId": "run_golden",
      "templateId": "tpl_builtin_default_system",
      "templateName": "builtin/default-system",
      "version": 1
    },
    {
      "id": "rtv_golden_1",
      "runId": "run_golden",
      "templateId": "tpl_builtin_default_task",
      "templateName": "builtin/default-task",
      "version": 1
    },
    {
      "id": "rtv_golden_2",
      "runId": "run_golden",
      "templateId": "tpl_builtin_delegated_task",
      "templateName": "builtin/delegated-task",
      "version": 1
    },
    {
      "id": "rtv_golden_3",
      "runId": "run_golden",
      "templateId": "tpl_builtin_garrison_tools_instructions",
      "templateName": "builtin/garrison-tools-instructions",
      "version": 1
    },
    {
      "id": "rtv_golden_4",
      "runId": "run_golden",
      "templateId": "tpl_builtin_mux_endpoints",
      "templateName": "builtin/mux-endpoints",
      "version": 1
    },
    {
      "id": "rtv_golden_5",
      "runId": "run_golden",
      "templateId": "tpl_builtin_mux_settings",
      "templateName": "builtin/mux-settings",
      "version": 1
    },
    {
      "id": "rtv_golden_6",
      "runId": "run_golden",
      "templateId": "tpl_builtin_mux_subagents",
      "templateName": "builtin/mux-subagents",
      "version": 1
    },
    {
      "id": "rtv_golden_7",
      "runId": "run_golden",
      "templateId": "tpl_builtin_mux_mcp_config",
      "templateName": "builtin/mux-mcp-config",
      "version": 1
    }
  ]
}
