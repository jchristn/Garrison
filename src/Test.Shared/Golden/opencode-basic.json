{
  "spec": {
    "runId": "run_golden",
    "tenantId": "ten_golden",
    "agentName": "helper-opencode-basic",
    "deploymentId": "dep_opencode_basic",
    "deploymentName": "helper-opencode-basic-default",
    "harnessType": "OpenCode",
    "executable": "opencode",
    "arguments": [
      "run",
      "--format",
      "json",
      "--thinking",
      "--auto",
      "--title",
      "garrison run_golden",
      "-m",
      "test-model"
    ],
    "environment": [
      {
        "name": "ANTHROPIC_API_KEY",
        "value": "credential-opencode_basic",
        "isSecret": true
      },
      {
        "name": "OPENCODE_CONFIG",
        "value": "$GARRISON_CONFIG_DIR/opencode.json",
        "isSecret": false
      },
      {
        "name": "OPENCODE_DISABLE_PROJECT_CONFIG",
        "value": "1",
        "isSecret": false
      },
      {
        "name": "OPENCODE_DISABLE_AUTOUPDATE",
        "value": "1",
        "isSecret": false
      },
      {
        "name": "OPENCODE_DISABLE_LSP_DOWNLOAD",
        "value": "1",
        "isSecret": false
      }
    ],
    "files": [
      {
        "baseDirectory": "Config",
        "path": "system-prompt.md",
        "content": "You are Helper, an agent operated by Garrison.\n\nAnswers questions about the repository.\n\nWork only inside your current working directory. When you are done, reply with your final answer.\n",
        "isSecret": false
      },
      {
        "baseDirectory": "Config",
        "path": "opencode.json",
        "content": "{\n  \u0022$schema\u0022: \u0022https://opencode.ai/config.json\u0022,\n  \u0022autoupdate\u0022: false,\n  \u0022instructions\u0022: [\u0022$GARRISON_CONFIG_DIR/system-prompt.md\u0022],\n  \u0022mcp\u0022: {\n  }\n}\n",
        "mode": "600",
        "isSecret": true
      }
    ],
    "stdin": "Summarize the repository.\n",
    "workspace": {
      "kind": "Empty",
      "gitDepth": 1,
      "files": [],
      "retention": "Delete"
    },
    "parser": "OpenCodeJsonl",
    "parserOptions": {
      "approvalsRelayed": false
    },
    "resultSource": "ParserFinalEvent",
    "successPolicy": "FinalEventAndExitCode",
    "successExitCodes": [
      0
    ],
    "timeoutSeconds": 1800,
    "killGraceSeconds": 5,
    "maxOutputBytes": 67108864,
    "stderrTailBytes": 8000,
    "repetitionGuard": true,
    "maxAssistantChars": 200000,
    "noProgressSeconds": 300,
    "isolateHome": true,
    "mcpPreflight": [],
    "scrubValues": [
      "credential-opencode_basic"
    ],
    "retainForRepair": false,
    "repairAttempt": 0,
    "executor": "Process",
    "egressRules": []
  },
  "templateVersions": [
    {
      "id": "rtv_golden_0",
      "runId": "run_golden",
      "templateId": "tpl_builtin_default_system",
      "templateName": "builtin/default-system",
      "version": 1
    },
    {
      "id": "rtv_golden_1",
      "runId": "run_golden",
      "templateId": "tpl_builtin_default_task",
      "templateName": "builtin/default-task",
      "version": 1
    },
    {
      "id": "rtv_golden_2",
      "runId": "run_golden",
      "templateId": "tpl_builtin_opencode_config",
      "templateName": "builtin/opencode-config",
      "version": 1
    }
  ]
}
