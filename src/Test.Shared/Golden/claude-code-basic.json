{
  "spec": {
    "runId": "run_golden",
    "tenantId": "ten_golden",
    "agentName": "helper-claude-code-basic",
    "deploymentId": "dep_claude_code_basic",
    "deploymentName": "helper-claude-code-basic-default",
    "harnessType": "ClaudeCode",
    "executable": "claude",
    "arguments": [
      "-p",
      "--output-format",
      "stream-json",
      "--verbose",
      "--include-partial-messages",
      "--setting-sources",
      "",
      "--disable-slash-commands",
      "--permission-mode",
      "acceptEdits",
      "--system-prompt-file",
      "$GARRISON_CONFIG_DIR/system-prompt.md",
      "--model",
      "test-model",
      "--max-turns",
      "20",
      "--strict-mcp-config",
      "--allowedTools",
      "Bash,Read,Edit,Write,Glob,Grep,WebFetch,WebSearch,mcp__garrison"
    ],
    "environment": [
      {
        "name": "CLAUDE_CODE_OAUTH_TOKEN",
        "value": "credential-claude_code_basic",
        "isSecret": true
      },
      {
        "name": "DISABLE_AUTOUPDATER",
        "value": "1",
        "isSecret": false
      },
      {
        "name": "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC",
        "value": "1",
        "isSecret": false
      },
      {
        "name": "MCP_TOOL_TIMEOUT",
        "value": "600000",
        "isSecret": false
      }
    ],
    "files": [
      {
        "baseDirectory": "Config",
        "path": "system-prompt.md",
        "content": "You are Helper, an agent operated by Garrison.\n\nAnswers questions about the repository.\n\nWork only inside your current working directory. When you are done, reply with your final answer.\n",
        "isSecret": false
      }
    ],
    "stdin": "Summarize the repository.\n",
    "workspace": {
      "kind": "Empty",
      "gitDepth": 1,
      "files": [],
      "retention": "Delete"
    },
    "parser": "ClaudeStreamJson",
    "parserOptions": {
      "approvalsRelayed": false
    },
    "resultSource": "ParserFinalEvent",
    "successPolicy": "FinalEvent",
    "successExitCodes": [
      0
    ],
    "timeoutSeconds": 1800,
    "killGraceSeconds": 5,
    "maxOutputBytes": 67108864,
    "stderrTailBytes": 8000,
    "repetitionGuard": true,
    "maxAssistantChars": 200000,
    "noProgressSeconds": 300,
    "isolateHome": true,
    "mcpPreflight": [],
    "scrubValues": [
      "credential-claude_code_basic"
    ],
    "retainForRepair": false,
    "repairAttempt": 0,
    "executor": "Process",
    "egressRules": []
  },
  "templateVersions": [
    {
      "id": "rtv_golden_0",
      "runId": "run_golden",
      "templateId": "tpl_builtin_default_system",
      "templateName": "builtin/default-system",
      "version": 1
    },
    {
      "id": "rtv_golden_1",
      "runId": "run_golden",
      "templateId": "tpl_builtin_default_task",
      "templateName": "builtin/default-task",
      "version": 1
    }
  ]
}
