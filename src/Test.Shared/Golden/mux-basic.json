{
  "spec": {
    "runId": "run_golden",
    "tenantId": "ten_golden",
    "agentName": "helper-mux-basic",
    "deploymentId": "dep_mux_basic",
    "harnessType": "Mux",
    "executable": "mux",
    "arguments": [
      "--print",
      "--config-dir",
      "$GARRISON_CONFIG_DIR/mux",
      "-e",
      "garrison",
      "--output-format",
      "jsonl",
      "--yolo",
      "--sandbox",
      "workspace-write",
      "-w",
      "$GARRISON_WORKSPACE_DIR",
      "-m",
      "test-model",
      "--max-turns",
      "20",
      "--system-prompt",
      "$GARRISON_CONFIG_DIR/system-prompt.md",
      "--output-last-message",
      "$GARRISON_CONFIG_DIR/last-message.txt",
      "--no-session-persistence"
    ],
    "environment": [
      {
        "name": "GARRISON_MUX_API_KEY",
        "value": "credential-mux_basic",
        "isSecret": true
      },
      {
        "name": "MUX_TELEMETRY_ENABLED",
        "value": "false",
        "isSecret": false
      },
      {
        "name": "MUX_CONFIG_DIR",
        "value": "$GARRISON_CONFIG_DIR/mux",
        "isSecret": false
      }
    ],
    "files": [
      {
        "baseDirectory": "Config",
        "path": "system-prompt.md",
        "content": "You are Helper, an agent operated by Garrison.\n\nAnswers questions about the repository.\n\nWork only inside your current working directory. When you are done, reply with your final answer.\n",
        "isSecret": false
      },
      {
        "baseDirectory": "Config",
        "path": "mux/endpoints.json",
        "content": "{\n  \u0022endpoints\u0022: [\n    {\n      \u0022name\u0022: \u0022garrison\u0022,\n      \u0022adapterType\u0022: \u0022openai-compatible\u0022,\n      \u0022baseUrl\u0022: \u0022http://ollama:11434/v1\u0022,\n      \u0022model\u0022: \u0022test-model\u0022,\n      \u0022apiKey\u0022: \u0022${GARRISON_MUX_API_KEY}\u0022,\n      \u0022isDefault\u0022: true,\n      \u0022timeoutMs\u0022: 600000,\n      \u0022autoApproveTools\u0022: true\n    }\n  ]\n}\n",
        "isSecret": false
      },
      {
        "baseDirectory": "Config",
        "path": "mux/settings.json",
        "content": "{\n  \u0022skillsEnabled\u0022: false,\n  \u0022projectSkillsEnabled\u0022: false,\n  \u0022taskPlanningEnabled\u0022: false,\n  \u0022memoryEnabled\u0022: false,\n  \u0022fileMentionMaxBytes\u0022: 0,\n  \u0022setupCompleted\u0022: true\n}\n",
        "isSecret": false
      },
      {
        "baseDirectory": "Config",
        "path": "mux/subagents.json",
        "content": "{\n  \u0022subagents\u0022: []\n}\n",
        "isSecret": false
      }
    ],
    "stdin": "Summarize the repository.\n",
    "workspace": {
      "kind": "Empty",
      "gitDepth": 1,
      "files": [],
      "retention": "Delete"
    },
    "parser": "MuxJsonl",
    "parserOptions": {},
    "resultSource": "LastMessageFile",
    "resultFileName": "last-message.txt",
    "successPolicy": "FinalEventAndExitCode",
    "successExitCodes": [
      0
    ],
    "timeoutSeconds": 1800,
    "killGraceSeconds": 5,
    "maxOutputBytes": 67108864,
    "stderrTailBytes": 8000,
    "repetitionGuard": true,
    "maxAssistantChars": 200000,
    "noProgressSeconds": 300,
    "isolateHome": true,
    "mcpPreflight": [],
    "scrubValues": [
      "credential-mux_basic"
    ],
    "retainForRepair": false,
    "repairAttempt": 0
  },
  "templateVersions": [
    {
      "id": "rtv_golden_0",
      "runId": "run_golden",
      "templateId": "tpl_builtin_default_system",
      "templateName": "builtin/default-system",
      "version": 1
    },
    {
      "id": "rtv_golden_1",
      "runId": "run_golden",
      "templateId": "tpl_builtin_default_task",
      "templateName": "builtin/default-task",
      "version": 1
    },
    {
      "id": "rtv_golden_2",
      "runId": "run_golden",
      "templateId": "tpl_builtin_mux_endpoints",
      "templateName": "builtin/mux-endpoints",
      "version": 1
    },
    {
      "id": "rtv_golden_3",
      "runId": "run_golden",
      "templateId": "tpl_builtin_mux_settings",
      "templateName": "builtin/mux-settings",
      "version": 1
    },
    {
      "id": "rtv_golden_4",
      "runId": "run_golden",
      "templateId": "tpl_builtin_mux_subagents",
      "templateName": "builtin/mux-subagents",
      "version": 1
    }
  ]
}
