{
  "name": "builtin/mux",
  "description": "Mux print mode (Mux 1.3.0) with JSONL events against a configurable OpenAI-compatible (or other) endpoint. The final answer comes from --output-last-message. Agents with an output schema, and conversation turns, run under --session-id <run id> so a structured output repair or the next turn can --resume the session.",
  "harnessType": "Mux",
  "executable": "mux",
  "promptDelivery": "Stdin",
  "systemPromptDelivery": "File",
  "systemPromptTarget": "system-prompt.md",
  "mcpConfigFormat": "MuxJson",
  "mcpConfigFileName": "mux-mcp.json",
  "outputParser": "MuxJsonl",
  "resultSource": "LastMessageFile",
  "resultFileName": "last-message.txt",
  "successPolicy": "FinalEventAndExitCode",
  "defaultTimeoutSeconds": 1800,
  "killGraceSeconds": 5,
  "isolateHome": true,
  "supportsResume": true,
  "sessionFormat": "mux-session-json-v1",
  "arguments": [
    {
      "template": "--print"
    },
    {
      "template": "--config-dir"
    },
    {
      "template": "$GARRISON_CONFIG_DIR/mux"
    },
    {
      "template": "-e"
    },
    {
      "template": "garrison"
    },
    {
      "template": "--output-format"
    },
    {
      "template": "jsonl"
    },
    {
      "template": "--yolo",
      "condition": "{{#unless deployment.parameters.approvalPolicy}}true{{/unless}}"
    },
    {
      "template": "--approval-policy",
      "condition": "{{deployment.parameters.approvalPolicy}}"
    },
    {
      "template": "{{deployment.parameters.approvalPolicy}}",
      "condition": "{{deployment.parameters.approvalPolicy}}"
    },
    {
      "template": "--sandbox"
    },
    {
      "template": "{{deployment.parameters.sandbox | default: \"workspace-write\"}}"
    },
    {
      "template": "-w"
    },
    {
      "template": "$GARRISON_WORKSPACE_DIR"
    },
    {
      "template": "-m",
      "condition": "{{deployment.model}}"
    },
    {
      "template": "{{deployment.model}}",
      "condition": "{{deployment.model}}"
    },
    {
      "template": "--context-window",
      "condition": "{{deployment.parameters.contextWindow}}"
    },
    {
      "template": "{{deployment.parameters.contextWindow}}",
      "condition": "{{deployment.parameters.contextWindow}}"
    },
    {
      "template": "--max-turns"
    },
    {
      "template": "{{deployment.maxTurns | default: \"20\"}}"
    },
    {
      "template": "--system-prompt",
      "condition": "{{prompts.system}}"
    },
    {
      "template": "$GARRISON_CONFIG_DIR/system-prompt.md",
      "condition": "{{prompts.system}}"
    },
    {
      "template": "--mcp-config",
      "condition": "{{resources.hasMcpServers}}"
    },
    {
      "template": "$GARRISON_CONFIG_DIR/mux-mcp.json",
      "condition": "{{resources.hasMcpServers}}"
    },
    {
      "template": "--strict-mcp-config",
      "condition": "{{resources.hasMcpServers}}"
    },
    {
      "template": "--output-schema",
      "condition": "{{agent.outputSchema}}"
    },
    {
      "template": "$GARRISON_CONFIG_DIR/output-schema.json",
      "condition": "{{agent.outputSchema}}"
    },
    {
      "template": "--output-last-message"
    },
    {
      "template": "$GARRISON_CONFIG_DIR/last-message.txt"
    },
    {
      "template": "--no-session-persistence",
      "condition": "{{#unless run.persistSession}}true{{/unless}}"
    },
    {
      "template": "--session-id",
      "condition": "{{#if run.persistSession}}{{#unless run.resumeSessionId}}true{{/unless}}{{/if}}"
    },
    {
      "template": "{{run.id}}",
      "condition": "{{#if run.persistSession}}{{#unless run.resumeSessionId}}true{{/unless}}{{/if}}"
    },
    {
      "template": "--resume",
      "condition": "{{run.resumeSessionId}}"
    },
    {
      "template": "{{run.resumeSessionId}}",
      "condition": "{{run.resumeSessionId}}"
    }
  ],
  "environment": [
    {
      "name": "GARRISON_MUX_API_KEY",
      "valueTemplate": "{{secret.kind.OpenAiApiKey}}",
      "isSecret": true
    },
    {
      "name": "MUX_TELEMETRY_ENABLED",
      "valueTemplate": "false",
      "isSecret": false
    },
    {
      "name": "MUX_CONFIG_DIR",
      "valueTemplate": "$GARRISON_CONFIG_DIR/mux",
      "isSecret": false
    }
  ],
  "files": [
    {
      "baseDirectory": "Config",
      "pathTemplate": "system-prompt.md",
      "contentTemplate": "{{prompts.system}}",
      "isSecret": false,
      "condition": "{{prompts.system}}"
    },
    {
      "baseDirectory": "Config",
      "pathTemplate": "output-schema.json",
      "contentTemplate": "{{agent.outputSchema}}",
      "isSecret": false,
      "condition": "{{agent.outputSchema}}"
    },
    {
      "baseDirectory": "Config",
      "pathTemplate": "mux/endpoints.json",
      "contentTemplate": "{{> builtin/mux-endpoints}}",
      "isSecret": false
    },
    {
      "baseDirectory": "Config",
      "pathTemplate": "mux/settings.json",
      "contentTemplate": "{{> builtin/mux-settings}}",
      "isSecret": false
    },
    {
      "baseDirectory": "Config",
      "pathTemplate": "mux/subagents.json",
      "contentTemplate": "{{> builtin/mux-subagents}}",
      "isSecret": false
    },
    {
      "baseDirectory": "Config",
      "pathTemplate": "mux-mcp.json",
      "contentTemplate": "{{> builtin/mux-mcp-config}}",
      "isSecret": false,
      "condition": "{{resources.hasMcpServers}}"
    }
  ],
  "successExitCodes": [
    0
  ],
  "probeArguments": [
    "--version"
  ],
  "credentialEnvironmentAllowlist": [
    "GARRISON_MUX_API_KEY"
  ],
  "assetPlacements": [
    {
      "kind": "Skill",
      "pathTemplate": "assets/{{asset.name}}",
      "listInSystemPrompt": true
    },
    {
      "kind": "ReferenceFile",
      "pathTemplate": "assets/{{asset.name}}",
      "listInSystemPrompt": true
    },
    {
      "kind": "DocumentTemplate",
      "pathTemplate": "assets/{{asset.name}}",
      "listInSystemPrompt": true
    }
  ],
  "toolProbes": [
    {
      "name": "pandoc",
      "executable": "pandoc",
      "arguments": [
        "--version"
      ],
      "description": "Converts documents between formats such as Markdown, HTML, DOCX, and PDF (with a PDF engine)."
    },
    {
      "name": "libreoffice",
      "executable": "soffice",
      "arguments": [
        "--version"
      ],
      "description": "LibreOffice in headless mode: converts office documents (DOCX, XLSX, PPTX, ODT) to PDF and other formats."
    },
    {
      "name": "python3",
      "executable": "python3",
      "arguments": [
        "--version"
      ],
      "description": "Python 3 interpreter for scripts and data processing."
    }
  ]
}
