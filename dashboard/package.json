{
  "name": "garrison-dashboard",
  "version": "0.2.0",
  "private": true,
  "description": "Operator console for Garrison, a multi-tenant control plane for headless agent harnesses.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src tests --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "playwright test --config playwright.live.config.js",
    "test:contract": "node tests/contract/run.mjs"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "dompurify": "^3.4.16",
    "i18next": "^24.2.0",
    "i18next-browser-languagedetector": "^8.0.2",
    "marked": "^18.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.0",
    "react-router-dom": "^7.1.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.49.1",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.14.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^17.9.0",
    "jsdom": "^25.0.1",
    "vite": "^6.0.7",
    "vitest": "^5.0.3"
  }
