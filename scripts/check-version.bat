@echo off
rem Fails when a file that mirrors the Garrison version disagrees with src/Directory.Build.props,
rem or when it carries an -alpha Garrison version. Mirrors are listed in scripts/version-mirrors.txt.
rem Versions and tags are v0.x.y with no -alpha suffix; a 0.x version means alpha.
pushd "%~dp0.."
powershell -NoProfile -Command "$token='[0-9]+\.[0-9]+\.[0-9]+[0-9A-Za-z.-]*'; $props=[System.IO.File]::ReadAllText('src/Directory.Build.props'); $m=[regex]::Match($props,'<Version>([^<]+)</Version>'); if (-not $m.Success) { Write-Error 'no <Version> found in src/Directory.Build.props'; exit 1 }; $version=$m.Groups[1].Value; $bad=$false; if ($version.Contains('-alpha')) { Write-Output ('src/Directory.Build.props: version ' + $version + ' carries -alpha; a 0.x version already means alpha'); $bad=$true }; $files=@(); foreach ($entry in [System.IO.File]::ReadAllLines('scripts/version-mirrors.txt')) { if ($entry -eq '' -or $entry.StartsWith('#')) { continue }; $i=$entry.IndexOf('|'); $file=$entry.Substring(0,$i); $pattern=$entry.Substring($i+1); if (-not (Test-Path $file)) { Write-Output ($file + ': listed in scripts/version-mirrors.txt but missing'); $bad=$true; continue }; $files+=$file; $regex=$pattern.Replace('@V@',$token); $n=0; $hits=0; foreach ($line in [System.IO.File]::ReadAllLines($file)) { $n++; foreach ($hit in [regex]::Matches($line,$regex)) { $hits++; $found=([regex]::Matches($hit.Value,$token) | Select-Object -Last 1).Value; if ($found -ne $version) { Write-Output ($file + ':' + $n + ': version ' + $found + ' does not match ' + $version); $bad=$true } } }; if ($hits -eq 0) { Write-Output ($file + ': no line matches ''' + $pattern + ''' (mirror moved or removed; update scripts/version-mirrors.txt)'); $bad=$true } }; foreach ($file in ($files | Sort-Object -Unique)) { $n=0; foreach ($line in [System.IO.File]::ReadAllLines($file)) { $n++; if ($line -match '[0-9]+\.[0-9]+\.[0-9]+-alpha') { Write-Output ($file + ':' + $n + ': ' + $line); $bad=$true } } }; if ($bad) { Write-Error ('version mirrors disagree with src/Directory.Build.props (' + $version + '); fix the lines above'); exit 1 } else { Write-Output ('all version mirrors report ' + $version) }"
set RESULT=%ERRORLEVEL%
popd
exit /b %RESULT%
