# Template for docker/.env. update.sh, update.bat, and factory/reset create .env from this file when it is missing and
# append random values for every key, password, and seeded credential that is not set (env-secrets.sh, .ps1). Ports
# and harness credentials are optional; unset ports use the defaults in compose.yaml. The keys and passwords have no
# defaults: Compose refuses to start without them, and the server refuses its public built-in defaults.
# .env is ignored by git. Never commit real keys.

# Host ports (bound to 127.0.0.1 only). If update.sh reports a port in use, pick free ones here, for example
# 9700, 9701, 9080, and 9433. Only the host side changes; the services still reach each other on their usual ports.
GARRISON_REST_PORT=8700
GARRISON_MCP_PORT=8701
GARRISON_DASHBOARD_PORT=8080
GARRISON_POSTGRES_PORT=5433

# Observability profile (./update.sh --observability, or docker compose -f compose.yaml -f compose.observability.yaml
# --profile observability up -d). Grafana user admin; set a real password for anything shared.
GARRISON_GRAFANA_PORT=3000
GARRISON_PROMETHEUS_PORT=9090
GARRISON_LOKI_PORT=3100
GARRISON_TEMPO_PORT=3200
# Generated when missing. Grafana applies it when its volume is first created.
# GARRISON_GRAFANA_PASSWORD=
# To run the observability profile with every plain docker compose command, uncomment both (use ; instead of : in
# COMPOSE_FILE on Windows):
# COMPOSE_FILE=compose.yaml:compose.observability.yaml
# COMPOSE_PROFILES=observability

# URL that A2A agent cards and server info advertise to callers outside the Compose network. Defaults to
# http://127.0.0.1:<GARRISON_REST_PORT>. Set it when clients reach Garrison through another host name or a proxy.
# Runs inside the stack keep using the internal service name (http://garrison-server:8700) either way.
# GARRISON_EXTERNAL_BASE_URL=https://garrison.example.com

# Dashboard API origin. By default the console calls the API on its own origin (http://127.0.0.1:8080) and nginx
# proxies /v1.0 to the server, so neither setting is needed. GARRISON_API_URL sends the browser to a different API
# origin instead; the dashboard allows that origin in its Content-Security-Policy for you.
# GARRISON_API_URL=https://garrison-api.example.com
# Extra space-separated origins the browser may call. Setting it also shows "Use a different server" on the sign-in
# page, so you can type one of these servers; leave it empty and the sign-in page has no server field.
# GARRISON_CSP_CONNECT_SRC=http://127.0.0.1:9700 ws://127.0.0.1:9700

# Administrator (seeded on first start only). The password and the API key are generated when missing; update.sh
# prints a generated password once, and it stays in this file.
GARRISON_ADMIN_EMAIL=admin@garrison
# GARRISON_ADMIN_PASSWORD=
# GARRISON_ADMIN_API_KEY=

# Keys, the database password, and the seeded credentials, generated when missing before the first start. They are
# bound to the database once it exists. Rotate the master key with the previous-key read ring and bounded
# rotation endpoint described in docs/KEY_ROTATION.md; replacing it without the old read key makes stored
# secrets unreadable. Signing-key changes invalidate existing sessions. Seeded admin keys only apply at bootstrap.
# GARRISON_MASTER_KEY=
# GARRISON_AUTH_SIGNING_KEY=
# GARRISON_DB_PASSWORD=
# GARRISON_DEFAULT_ACCESS_KEY=
# GARRISON_DEFAULT_SECRET_KEY=
# GARRISON_NODE_ACCESS_KEY=
# GARRISON_NODE_SECRET_KEY=

# Harness credentials. The bootstrap container stores whichever are set as Garrison secrets and creates the
# matching sample agent deployments (claude-helper, codex-coder, mux-helper).
# A Claude subscription token from `claude setup-token`, or an Anthropic API key:
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Absolute path to a Codex auth.json (ChatGPT sign-in), for example /Users/you/.codex/auth.json. "~" is not expanded.
# CODEX_AUTH_JSON_FILE=
# MUX_BASE_URL=
# MUX_MODEL=
# openai-compatible (the default) or ollama
# MUX_ADAPTER_TYPE=openai-compatible
# MUX_API_KEY=
# Optional. The model's context window in tokens (1024 to 1048576, passed as --context-window) and the most tokens
# one response may generate (1024 to 131072, written to the endpoint). Unset means Mux uses its defaults: a
# 32768-token window (Garrison adds a warning to every Mux run) and 8192 response tokens.
# MUX_CONTEXT_WINDOW=131072
# MUX_MAX_TOKENS=8192

# Optional external coordination. Database requires no Clutch service and remains the default.
# Configure every replica identically; the endpoint must be reachable from the server container.
# GARRISON_LEASE_PROVIDER=Clutch
# GARRISON_CLUTCH_ENDPOINT=https://clutch.example.com
# GARRISON_CLUTCH_ACCESS_KEY=
# GARRISON_CLUTCH_KEY_PREFIX=garrison-production
