# Copy to .env and edit. Every value is optional; unset values use the defaults in compose.yaml.
# .env is ignored by git. Never commit real keys.

# Host ports (bound to 127.0.0.1 only). If update.sh reports a port in use, pick free ones here, for example
# 9700, 9701, 9080, and 9433. Only the host side changes; the services still reach each other on their usual ports.
GARRISON_REST_PORT=8700
GARRISON_MCP_PORT=8701
GARRISON_DASHBOARD_PORT=8080
GARRISON_POSTGRES_PORT=5433

# URL that A2A agent cards and server info advertise to callers outside the Compose network. Defaults to
# http://127.0.0.1:<GARRISON_REST_PORT>. Set it when clients reach Garrison through another host name or a proxy.
# Runs inside the stack keep using the internal service name (http://garrison-server:8700) either way.
# GARRISON_EXTERNAL_BASE_URL=https://garrison.example.com

# Administrator (seeded on first start only; change before the stack is reachable by anyone else)
GARRISON_ADMIN_EMAIL=admin@garrison
GARRISON_ADMIN_PASSWORD=password
GARRISON_ADMIN_API_KEY=garrisonadmin

# Keys. Set long random values for anything shared, before the first start: the master key encrypts stored
# secrets, so changing it later makes existing secrets unreadable (run factory/reset to start over).
# GARRISON_MASTER_KEY=
# GARRISON_AUTH_SIGNING_KEY=
# GARRISON_DB_PASSWORD=
# GARRISON_DEFAULT_ACCESS_KEY=
# GARRISON_DEFAULT_SECRET_KEY=
# GARRISON_NODE_ACCESS_KEY=
# GARRISON_NODE_SECRET_KEY=

# Harness credentials. The bootstrap container stores whichever are set as Garrison secrets and creates the
# matching sample agent deployments (claude-helper, codex-coder, mux-helper).
# A Claude subscription token from `claude setup-token`, or an Anthropic API key:
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Absolute path to a Codex auth.json (ChatGPT sign-in), for example /Users/you/.codex/auth.json. "~" is not expanded.
# CODEX_AUTH_JSON_FILE=
# MUX_BASE_URL=
# MUX_MODEL=
# openai-compatible (the default) or ollama
# MUX_ADAPTER_TYPE=openai-compatible
# MUX_API_KEY=
