     },
     "expr": "topk(10, sum by (http_route) (rate(http_server_request_duration_seconds_sum{job=\"garrison\", component=\"server\", node=~\"$node\", http_route=~\"$route\"}[$window])) / sum by (http_route) (rate(http_server_request_duration_seconds_count{job=\"garrison\", component=\"server\", node=~\"$node\", http_route=~\"$route\"}[$window])))",
     "legendFormat": "{{http_route}}",
     "refId": "A",
     "range": true,
     "instant": false,
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
