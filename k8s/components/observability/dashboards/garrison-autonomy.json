    {
      "type": "timeseries",
      "title": "Tick start lag",
      "description": "Time from a wake coming due to the scheduler starting its tick (p50, p95, p99). Rising lag means the sweep is behind: raise Autonomy.MaxDueClaimsPerSweep or lower Autonomy.SchedulerSweepSeconds.",
      "datasource": {
        "type": "prometheus",
        "uid": "garrison-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "garrison-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(garrison_keeper_tick_lag_duration_seconds_bucket{node=~\"$node\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "garrison-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(garrison_keeper_tick_lag_duration_seconds_bucket{node=~\"$node\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B",
          "range": true,
          "instant": false,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "garrison-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(garrison_keeper_tick_lag_duration_seconds_bucket{node=~\"$node\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
