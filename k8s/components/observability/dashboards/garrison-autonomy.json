    {
      "type": "timeseries",
      "title": "Tick start lag",
      "description": "Time from a wake coming due to the scheduler starting its tick (p50, p95, p99). Rising lag means the sweep is behind: raise Autonomy.MaxDueClaimsPerSweep or lower Autonomy.SchedulerSweepSeconds.",
      "datasource": {
        "type": "prometheus",
        "uid": "garrison-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "garrison-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(garrison_keeper_tick_lag_duration_seconds_bucket{node=~\"$node\"}[$__rate_interval])))",
