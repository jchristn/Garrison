        "type": "prometheus",
        "uid": "garrison-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "garrison-prometheus"
          },
          "expr": "sum by (action) (rate(garrison_freezes_total{node=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "{{action}}",
