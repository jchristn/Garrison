{
  "uid": "garrison-autonomy",
  "title": "Garrison / Autonomy",
  "description": "Keepers: ticks by outcome and wake source, skipped and failed wakes, tick start lag, and the intervals the scheduler applies. Later phases add messaging and evaluation rows.",
  "tags": [
    "garrison"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "liveNow": false,
