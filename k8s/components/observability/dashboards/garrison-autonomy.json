    {
      "type": "stat",
      "title": "Ticks",
      "description": "Keeper ticks finished or skipped in the selected range.",
      "datasource": {
        "type": "prometheus",
        "uid": "garrison-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "garrison-prometheus"
          },
          "expr": "round(sum(increase(garrison_keeper_ticks_total{node=~\"$node\"}[$__range]))) or on() vector(0)",
          "legendFormat": "__auto",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "noValue": "0",
          "decimals": 0
