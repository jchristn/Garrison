    {
      "type": "timeseries",
      "title": "Telemetry diagnostics",
      "description": "Messages reported by the telemetry pipeline (export failures and the like), by severity.",
      "datasource": {
        "type": "prometheus",
        "uid": "garrison-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "garrison-prometheus"
          },
          "expr": "sum by (severity, node) (increase(garrison_telemetry_diagnostics_total{node=~\"$node\"}[$__rate_interval])) or on() label_replace(vector(0), \"severity\", \"none\", \"\", \"\")",
          "legendFormat": "{{severity}} {{node}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "links": [
