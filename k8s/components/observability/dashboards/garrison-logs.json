    {
      "type": "timeseries",
      "title": "Log lines by level",
      "description": "Log lines per interval by level (Alloy promotes level, component, node, and tenant to labels).",
      "datasource": {
        "type": "loki",
        "uid": "garrison-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "garrison-loki"
          },
          "expr": "sum by (level) (count_over_time({app=\"garrison\", node=~\"${node:regex}\"} [$__auto]))",
          "legendFormat": "{{level}}",
          "refId": "A",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": true,
            "pointSize": 4,
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisPlacement": "auto",
            "gradientMode": "none",
