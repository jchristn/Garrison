  "list": [
   {
    "name": "node",
    "label": "Node",
    "description": "Garrison node: the server pod or container name, or the worker node name.",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "garrison-prometheus"
    },
    "query": {
     "query": "label_values(up{job=\"garrison\"}, node)",
     "refId": "PrometheusVariableQueryEditor-VariableQuery",
     "qryType": 1
    },
    "definition": "label_values(up{job=\"garrison\"}, node)",
    "refresh": 2,
    "sort": 1,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "options": [],
    "regex": "",
    "skipUrlSync": false,
    "hide": 0
   },
   {
    "name": "harness",
    "label": "Harness",
    "description": "Harness type. Empty until the first run is created.",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "garrison-prometheus"
    },
    "query": {
     "query": "label_values(garrison_runs_created_total, harness)",
     "refId": "PrometheusVariableQueryEditor-VariableQuery",
     "qryType": 1
    },
    "definition": "label_values(garrison_runs_created_total, harness)",
    "refresh": 2,
    "sort": 1,
    "multi": true,
