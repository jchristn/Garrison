          "uid": "garrison-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"garrison\"}, node)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(up{job=\"garrison\"}, node)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
