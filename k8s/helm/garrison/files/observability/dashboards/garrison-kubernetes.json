    {
      "type": "timeseries",
      "title": "Jobs by result",
      "description": "Run Jobs created, refused, and deleted.",
      "datasource": {
        "type": "prometheus",
        "uid": "garrison-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "garrison-prometheus"
          },
