{
  "name": "@garrison/sdk",
  "version": "0.2.0",
  "description": "JavaScript and TypeScript SDK for Garrison, the multi-tenant control plane for headless agent harnesses.",
  "license": "MIT",
  "author": "Joel Christner",
  "homepage": "https://github.com/jchristn/Garrison",
  "repository": {
    "type": "git",
    "url": "https://github.com/jchristn/Garrison.git",
    "directory": "sdk/js"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./gateway": {
      "types": "./dist/esm/gateway.d.ts",
      "import": "./dist/esm/gateway.js",
      "require": "./dist/cjs/gateway.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "gateway": [
        "./dist/esm/gateway.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "bin"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'}))\"",
    "test": "node test-harness.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "bin": {
    "garrison": "bin/console.mjs"
  }
}
